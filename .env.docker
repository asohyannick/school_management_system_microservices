@"
# ==============================================================
#  .env.docker - overrides applied ONLY to app containers
#  NO SECRETS HERE. Secrets live in .env (git-ignored).
# ==============================================================
DB_HOST=postgres
DB_PORT=5432
MYSQL_HOST=mysql
MONGO_HOST=mongodb
REDIS_HOST=redis
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
EUREKA_HOST=discovery-server
MINIO_ENDPOINT=http://minio:9000
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/sms/protocol/openid-connect/certs
"@ | Set-Content -Encoding ascii .env.docker

git add .env.docker
git commit --amend --no-edit
git show HEAD:.env.docker
